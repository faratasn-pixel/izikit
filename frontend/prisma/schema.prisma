generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  // Nullable+unique: E.164 phone number, used as the login identifier by the
  // phone/WhatsApp login screen. Signup for phone-based accounts is a
  // separate (not-yet-built) flow, so this stays null for existing
  // email/password and OAuth users.
  phone               String?   @unique
  // Real-estate persona from the Register screen's "Vous êtes" selector —
  // distinct from `role` (app-wide USER/ADMIN/SUPERADMIN). Gates access to
  // agent-only surfaces (Mes annonces, Publier une annonce, …) elsewhere.
  accountType         String    @default("TENANT_BUYER") // TENANT_BUYER | OWNER_AGENT
  // Nullable: OAuth-only users (e.g. signed up with Google) never set a
  // password. Email/password signup still requires it; the auth route
  // enforces presence at runtime.
  passwordHash        String?
  emailVerifiedAt     DateTime?
  tokenVersion        Int       @default(0)
  withdrawalPinHash   String? // bcrypt hash of withdrawal PIN; null = no PIN set
  // Optional display name — populated from OAuth profile on first sign-in.
  // Email/password users can fill it later via /api/auth/me PATCH (future).
  name                String?
  // Optional avatar URL — populated from OAuth profile on first sign-in.
  avatarUrl           String?
  // Optional profile fields, editable via PATCH /api/auth/me (/settings
  // Profil card). Free-form — no country-list/city-list validation.
  city                String?
  country             String?
  bio                 String?
  // Regional preferences, editable via PATCH /api/preferences/regional
  // (/settings "Langue & région" card). Real and persisted, but currently
  // DORMANT — no i18n library is wired in this starter, so `locale` doesn't
  // actually translate any UI text yet, and nothing formats dates/numbers
  // off `dateFormat`/`numberFormat` yet either. Reuses `city`/`country`
  // above for "Ville par défaut"/"Pays principal" rather than duplicating
  // them. See .planning/banani/langue-region.md.
  locale              String    @default("fr") // fr | en | pt | wo | fon | dyu
  timezone            String    @default("Africa/Cotonou") // free-form IANA-style string, not validated
  currency            String    @default("XOF_UEMOA") // XOF_UEMOA | XAF_CEMAC | GHS | NGN
  dateFormat          String    @default("DMY") // DMY | MDY | YMD
  numberFormat        String    @default("SPACE") // SPACE | COMMA | DOT
  // Appearance preferences, editable via PATCH /api/preferences/appearance
  // (/settings "Apparence" card). Real and persisted, but currently
  // DORMANT — this starter ships zero dark-mode CSS anywhere, so `theme`
  // doesn't actually restyle the app yet; same for the rest. Wiring a real
  // theme switch is a cross-cutting design-system change, out of scope for
  // a single settings tab. See .planning/banani/apparence-settings.md.
  theme               String    @default("LIGHT") // LIGHT | DARK | SYSTEM
  accentColor         String    @default("#376BFF") // free-form hex, not restricted to the swatch list
  fontScale           String    @default("NORMAL") // SMALL | NORMAL | LARGE
  density             String    @default("NORMAL") // COMPACT | NORMAL | SPACIOUS
  sidebarStyle        String    @default("EXPANDED") // EXPANDED | COMPACT
  animationsEnabled   Boolean   @default(true)
  hoverEffectsEnabled Boolean   @default(true)
  reduceMotion        Boolean   @default(false)
  // App-wide role. USER is the default; ADMIN unlocks /admin back-office;
  // SUPERADMIN can promote/demote other admins. Bootstrap an initial
  // SUPERADMIN via `pnpm db:make-superadmin <email>` (see scripts).
  role                String    @default("USER") // USER | ADMIN | SUPERADMIN
  // Account status. ACTIVE = login + refresh allowed; SUSPENDED = both
  // refused with 403 ACCOUNT_SUSPENDED. Mutated via /api/admin/users/[id]/status
  // (ADMIN can suspend; only SUPERADMIN can restore).
  status              String    @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  verificationCodes VerificationCode[]
  uploads           FileUpload[]
  legalDocuments    LegalDocument[]
  subscription      Subscription?
  notifications     Notification[]
  notifPrefs        NotificationPreferences?
  orders            Order[]
  withdrawals       Withdrawal[]
  oauthAccounts     OAuthAccount[]
  adminActions      AdminAction[]
  listings          Listing[]
  propertyRequests  PropertyRequest[]
  alerts            Alert[]

  // Multi-tenancy is opt-in per project: by default no resource is org-scoped.
  // Apps that need it (marketplace, B2B SaaS, classifieds) wire owner relations
  // on their domain models.
  ownedOrganizations Organization[]       @relation("OrgOwner")
  memberships        OrganizationMember[] @relation("OrgMembership")

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([status])
}

// ───────────────────────────────────────────────────────────────────────
// Admin audit log — every back-office mutation is recorded here so we can
// answer "who did what when" during incidents / compliance reviews.
//
// `action` is a free-form dotted string the UI groups by (e.g.
// "withdrawal.cancel", "user.role_change", "order.refund").
// `targetType` + `targetId` reference the affected row when applicable.
// `metadata` carries the diff or extra context as JSON.
//
// Retention: not pruned automatically (compliance). If your jurisdiction
// requires deletion after N years, add a cron in backend/src/index.ts
// modeled on the WebhookLog purge.
// ───────────────────────────────────────────────────────────────────────
model AdminAction {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// ───────────────────────────────────────────────────────────────────────
// Multi-tenancy primitives — opt-in.
//
// Default project surface stays user-owned (`Order.userId`, `Withdrawal.userId`).
// Apps that need orgs add `organizationId String?` to their domain models
// case by case and use `requireOrgRole()` middleware to gate access.
//
// Slug must be unique app-wide (not just within an owner) so it can be
// used as a stable URL segment.
// ───────────────────────────────────────────────────────────────────────
model Organization {
  id        String               @id @default(cuid())
  slug      String               @unique
  name      String
  ownerId   String
  owner     User                 @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members   OrganizationMember[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  // "Mon Agence" settings fields (Settings → Mon agence, phase 1: identity +
  // zones). Logo upload + team invites are phase 2 — no columns for those
  // yet (YAGNI until that pass).
  description     String?
  agencyType      String?
  address         String?
  phone           String?
  email           String?
  website         String?
  rccmNumber      String?
  facebookHandle  String?
  instagramHandle String?
  linkedinHandle  String?
  whatsappNumber  String?
  // Array of { country: string; cities: string[] } — free-form JSON, no
  // separate table: this is small, descriptive, never filtered/queried on.
  zones           Json    @default("[]")

  @@index([ownerId])
}

// Role precedence: OWNER > ADMIN > MEMBER. The owner is also a member row
// (created in the same tx as the org) so list-my-orgs queries can join
// uniformly via memberships.
model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("OrgMembership", fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // OWNER | ADMIN | MEMBER
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

// ───────────────────────────────────────────────────────────────────────
// OAuth identities — one User can have N linked providers (Google, GitHub, …).
// (provider, providerAccountId) is unique so the same Google account can't
// link twice. Email matching at sign-in is intentional: if a user signed up
// with email/password and later "Sign in with Google" using the same email,
// we link the Google account to the existing user instead of creating a
// duplicate (see backend/src/routes/oauth.ts).
// ───────────────────────────────────────────────────────────────────────
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "google" | "github" | …
  providerAccountId String // sub from the OIDC ID token
  // Optional refresh token (encrypted at rest if you store one) — Google
  // only returns it on first consent with `access_type=offline`. Most
  // boilerplate flows don't need it; we keep the column for future use.
  refreshToken      String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      String // EMAIL_VERIFY | PASSWORD_RESET
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([code, type])
}

// ───────────────────────────────────────────────────────────────────────
// File uploads — Cloudinary (column names kept from the R2 era; no migration needed)
// ───────────────────────────────────────────────────────────────────────
model FileUpload {
  id        String   @id @default(cuid())
  userId    String? // nullable — uploads can be anonymous if route allows
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  key       String   @unique // Cloudinary public_id (column name historical — was R2 object key)
  filename  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Legal documents — /settings "Documents légaux" tab (Banani screen
// mU9G3YPaywt9). Fixed set of 6 document types an agent must provide to earn
// the "Agent Vérifié" badge; one row per (userId, type) — re-uploading a type
// overwrites the previous file and resets status to PENDING. Verification
// (PENDING → VERIFIED/REJECTED) is an admin back-office action, not built in
// this pass — see .planning/banani/documents-legaux.md for the phase-2 scope.
// ───────────────────────────────────────────────────────────────────────
model LegalDocument {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String // ID_CARD | PRO_CARD | RCCM | TAX_CERTIFICATE | MANAGEMENT_MANDATE | LIABILITY_INSURANCE
  status          String    @default("PENDING") // PENDING | VERIFIED | REJECTED
  key             String // Cloudinary public_id
  url             String
  filename        String
  mimeType        String
  sizeBytes       Int
  expiresAt       DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, type])
  @@index([userId])
}

// ───────────────────────────────────────────────────────────────────────
// Subscriptions — /settings "Abonnement & paiement" tab (Banani screen
// iB8MbJT5-w3v). Absence of a row means "on the Free plan" — a row is only
// created on first upgrade (find-or-create, same convention as
// Organization). Plan changes to a paid plan go through the existing
// Order/Bictorys one-time-charge pipeline (metadata.kind =
// "subscription_plan_change"); the webhook activates the plan on payment
// confirmation. No renewal cron exists yet — currentPeriodEnd is
// informational only, see .planning/banani/abonnement-paiement.md.
// ───────────────────────────────────────────────────────────────────────
model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planKey          String    @default("FREE") // FREE | PRO_AGENT | AGENCY_PREMIUM
  status           String    @default("ACTIVE") // ACTIVE | CANCELED
  currentPeriodEnd DateTime?
  canceledAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — durable email queue rows
// ───────────────────────────────────────────────────────────────────────
model EmailJob {
  id          String    @id @default(cuid())
  to          String
  subject     String
  html        String
  text        String?
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — notifications (at-most-once via dedupeKey)
// ───────────────────────────────────────────────────────────────────────
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreferences {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // JSON map of { eventType: { email: bool, inApp: bool } } — flexible without migrations.
  prefs     Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// ───────────────────────────────────────────────────────────────────────
// Outbox — durable side-effects (notifications, emails) emitted from
// inside transactions (e.g. webhook handlers, withdrawal flow). Side-effect
// rows are inserted in the same tx as the state change, then a worker
// drains them. Survives crashes the previous postCommit-callback pattern
// silently dropped.
//
// `kind` is a free-form string the dispatcher routes on
// (e.g. "notification.payment_received", "email.payment_confirmation").
// ───────────────────────────────────────────────────────────────────────
model OutboxEvent {
  id          String    @id @default(cuid())
  kind        String
  payload     Json
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — webhook idempotency log
// ───────────────────────────────────────────────────────────────────────
model WebhookLog {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([externalId, eventType])
  @@index([provider, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 3 — payments (Order + Withdrawal)
//
// `amount` is stored in the smallest unit of `currency` (no decimals).
// For XOF (FCFA, Senegal) that's 1 = 1 FCFA. For USD adapt to cents
// at the call site — the schema is currency-agnostic.
// ───────────────────────────────────────────────────────────────────────
model Order {
  id            String  @id @default(cuid())
  userId        String? // nullable — guest checkout supported
  user          User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount        Int // gross amount, smallest unit
  currency      String  @default("XOF") // ISO 4217
  status        String  @default("PENDING") // PENDING | PAID | EXPIRED | FAILED | REFUNDED
  customerEmail String?
  customerPhone String?
  customerName  String?
  metadata      Json? // app-specific fields

  // Stripe-grade idempotency. Required header on POST /api/orders; replay
  // with same value returns the original Order row instead of double-charging.
  // Nullable so existing rows pre-migration don't break the @unique constraint.
  idempotencyKey String? @unique

  // Provider reference
  provider         String // e.g. "bictorys"
  providerChargeId String? @unique
  paymentUrl       String? // checkout/redirect URL returned by provider
  paymentMethod    String? // WAVE | ORANGE_MONEY | FREE_MONEY (set on PAID by webhook)

  // Optional commission (for marketplace-style apps)
  commissionAmount Int?
  netAmount        Int?

  // Lifecycle
  expiresAt DateTime // PENDING expiry; not cleared on PAID (history)
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([provider, providerChargeId])
}

model Withdrawal {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  amount      Int // requested amount, smallest unit
  currency    String @default("XOF")
  status      String @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED | CANCELLED
  destination Json // { method: "WAVE" | "ORANGE_MONEY" | ..., phone: "+221...", accountName?: "..." }

  // Provider reference
  provider         String // e.g. "bictorys"
  providerPayoutId String? @unique
  failureReason    String?

  requestedAt DateTime  @default(now())
  processedAt DateTime?
  completedAt DateTime?

  @@index([userId, requestedAt])
  @@index([status, requestedAt])
  @@index([provider, providerPayoutId])
}

// ───────────────────────────────────────────────────────────────────────
// Real-estate listing ("annonce") — the core domain object for the Agent
// Dashboard's "Mes annonces" table. Owned by the publishing User (typically
// accountType=OWNER_AGENT, not enforced at the schema level).
// ───────────────────────────────────────────────────────────────────────
model Listing {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title           String
  city            String
  country         String
  propertyType    String // VILLA | APPARTEMENT | PARCELLE | DOMAINE | MAISON | BOUTIQUE | BUREAU | SALLE_FETE | SALLE_CONFERENCE | IMMEUBLE
  transactionType String @default("VENTE") // VENTE | LOCATION | SEJOUR | AUBERGE
  price           Int // smallest currency unit (FCFA = no decimals); for RENT/SHORT_RENT this is the per-month price
  currency        String @default("XOF")
  status          String @default("PENDING") // DRAFT | PENDING | VERIFIED | SOLD

  // "Publier une annonce" fields (frontend/src/app/listings/new/page.tsx).
  // All nullable — a DRAFT listing may have none of them filled in yet;
  // required-for-publish validation happens at the API layer, not here.
  description String?
  landmark    String? // free-text point de repère ("non loin de la pharmacie X…")
  surfaceM2   Int?
  capacity    Int? // nombre de places (salle de fête / salle de conférence)
  yearBuilt   Int?
  standing    String? // BASIC | MID | HIGH
  roomsTotal  Int?
  bedrooms    Int?
  bathrooms   Int?
  kitchens    Int?
  amenities   Json    @default("[]") // string[] of amenity keys, e.g. ["POOL","PARKING"]

  photos    ListingPhoto[]
  documents ListingDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

// ───────────────────────────────────────────────────────────────────────
// Property search request ("demande immobilière") — an agent records a
// client/prospect's search criteria (frontend/src/app/demandes/new/page.tsx).
// Unlike Listing, this is a single-shot create (no draft/photo-upload
// flow), so every field is captured on the one POST that creates the row.
// ───────────────────────────────────────────────────────────────────────
model PropertyRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactionType String // VENTE | LOCATION | SEJOUR | AUBERGE
  propertyType    String // VILLA | APPARTEMENT | PARCELLE | DOMAINE | MAISON | BOUTIQUE | BUREAU | SALLE_FETE | SALLE_CONFERENCE | IMMEUBLE
  country         String
  city            String

  // Only the field(s) relevant to propertyType are populated by the client
  // (see LAND_/HALL_PROPERTY_TYPES in the form) — all nullable here since
  // which ones apply depends on propertyType.
  bedrooms  String? // e.g. "2 chambres"
  salons    String? // e.g. "1 salon"
  surfaceM2 Int?
  capacity  Int? // nombre de places (salle de fête / salle de conférence)

  amenities Json   @default("[]") // string[] of amenity keys, e.g. ["POOL","PARKING"]
  priority  String @default("Normale") // Urgent | Normale | Basse

  budgetMin Int?
  budgetMax Int?
  financing String // Comptant | Crédit | Les deux
  delay     String // Immédiat | 1–3 mois | 3–6 mois | Flexible

  clientName  String
  clientPhone String
  clientEmail String?
  clientType  String  @default("Particulier") // Particulier | Entreprise
  source      String?

  status String @default("EN_ATTENTE") // EN_ATTENTE | EN_COURS | CLOTUREE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matchedByAlerts AlertMatch[]

  @@index([userId, createdAt])
  @@index([status])
}

// ───────────────────────────────────────────────────────────────────────
// Sector alert ("alerte secteur") — a saved search that notifies the user
// when a matching PropertyRequest ("demande immobilière") is created, or
// vice versa. See frontend/src/lib/server/alerts/matching.ts.
// Single-shot create, same pattern as PropertyRequest.
// ───────────────────────────────────────────────────────────────────────
model Alert {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name            String
  transactionType String // VENTE | LOCATION | SEJOUR | AUBERGE
  propertyTypes   Json // string[] of PROPERTY_TYPE_LABEL keys, e.g. ["VILLA","APPARTEMENT"]
  country         String
  cities          Json // string[] of city names, e.g. ["Cotonou","Porto-Novo"]

  priceMin Int?
  priceMax Int?

  frequency     String  @default("QUOTIDIENNE") // QUOTIDIENNE | HEBDOMADAIRE
  notifWhatsapp Boolean @default(true)
  notifEmail    Boolean @default(true)
  notifSms      Boolean @default(false)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches AlertMatch[]

  @@index([userId, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Alert ↔ PropertyRequest match. Created by frontend/src/lib/server/alerts/matching.ts
// when a newly-created Alert or PropertyRequest satisfies the other side's
// criteria. The @@unique is the anti-duplicate-notification lock — also the
// data source for the "Correspondances" section on /alertes/[id].
// ───────────────────────────────────────────────────────────────────────
model AlertMatch {
  id                String          @id @default(cuid())
  alertId           String
  alert             Alert           @relation(fields: [alertId], references: [id], onDelete: Cascade)
  propertyRequestId String
  propertyRequest   PropertyRequest @relation(fields: [propertyRequestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([alertId, propertyRequestId])
  @@index([alertId, createdAt])
}

// One row per uploaded photo for a listing being published. `isPrimary`
// marks the cover photo shown in "Mes annonces" and search results — at
// most one per listing, enforced at the application layer (not a DB
// constraint, mirrors how other "exactly one flag" fields are handled
// elsewhere in this schema).
model ListingPhoto {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  key       String // Cloudinary public_id
  url       String
  isPrimary Boolean @default(false)
  position  Int     @default(0)

  createdAt DateTime @default(now())

  @@index([listingId, position])
}

// Listing-specific legal documents (titre foncier, mandat de vente, plan
// cadastral) — distinct from the user-level `LegalDocument` (ID card, pro
// card, RCCM, …). Same upsert-by-type + PENDING-on-upload convention.
model ListingDocument {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  type            String // LAND_TITLE | SALE_MANDATE | CADASTRAL_PLAN
  status          String  @default("PENDING") // PENDING | VERIFIED | REJECTED
  key             String // Cloudinary public_id
  url             String
  filename        String
  mimeType        String
  sizeBytes       Int
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, type])
}
